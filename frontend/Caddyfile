# Caddy untuk service frontend di Railway.
# Variabel: PORT (diisi Railway), BACKEND_INTERNAL_URL (mis.
# http://backend.railway.internal:8001), PUBLIC_SCHEME (default https).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode gzip

	handle /api/* {
		reverse_proxy {$BACKEND_INTERNAL_URL} {
			# Domain & skema asli diteruskan ke backend: dipakai untuk tautan QR
			# (https://<domain>/?s=KODE). Railway selalu melayani publik lewat https.
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {$PUBLIC_SCHEME:https}
		}
	}

	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
